{
    "defaults": {
        "lower_bound": 400.0,
        "upper_bound": 3300.0,
        "sg_poly_order": 1,
        "sg_frame_window": 15,
        "cosmic_ray_threshold": 5.0,
        "normalization": "none",
        "baseline": {
            "algorithm": "airpls",
            "params": {
                "lam": 1000000.0,
                "diff_order": 2,
                "p": 0.01
            }
        },
        "batch": {
            "parallel": true,
            "n_jobs": -1
        },
        "nmf": {
            "init": "nndsvda",
            "n_components": 3,
            "random_state": 0
        }
    },
    "validation": {
        "sg_poly_order_min": 1,
        "sg_frame_window_min": 3,
        "baseline_order_min": 0,
        "baseline_order_max": 20,
        "nmf_components_min": 2,
        "pca_n_components": 10
    },
    "baseline_algorithms": {
        "airpls": "airPLS (Adaptive Iter. Reweighted PLS)",
        "arpls": "arPLS (Asymmetrically Reweighted PLS)",
        "asls": "ALS (Asymmetric Least Squares)",
        "snip": "SNIP (Iterative Peak-Clipping)",
        "atq": "Asymmetric Truncated Quadratic",
        "stq": "Symmetric Truncated Quadratic",
        "ah": "Asymmetric Huber",
        "sh": "Symmetric Huber",
        "mor": "BubbleFill-like (Morphological)"
    },
    "normalization_methods": {
        "none": "None",
        "snv": "SNV (Standard Normal Variate)",
        "vector": "Vector (L2 Norm = 1)",
        "area": "Area (Unit Integral)",
        "minmax": "Min-Max [0, 1]",
        "maxpeak": "Max Peak (max = 1)"
    },
    "nmf_init_methods": {
        "nndsvda": "NNDSVDA (recommended)",
        "nndsvd": "NNDSVD",
        "nndsvdar": "NNDSVDAR (stochastic)",
        "random": "Random"
    },
    "pca_scaling_methods": {
        "auto": "Auto-scale (unit variance)",
        "mean": "Mean-center only",
        "pareto": "Pareto (sqrt std)",
        "none": "No scaling"
    },
    "peak_detection": {
        "prominence_percent": 2.0,
        "min_distance": 5,
        "default_profile": "gaussian"
    },
    "qc": {
        "snr_noise_region": [1800, 2000],
        "saturation_relative": 0.98
    },
    "derivative": {
        "enabled": false,
        "order": 1,
        "window": 15,
        "polyorder": 3
    },
    "clustering": {
        "default_linkage": "ward",
        "default_metric": "euclidean",
        "default_n_clusters": 3,
        "umap_n_neighbors": 15,
        "umap_min_dist": 0.1
    },
    "mcr_als": {
        "n_components": 3,
        "max_iter": 200,
        "init": "nmf",
        "nonneg_concentrations": true,
        "nonneg_spectra": true,
        "norm_spectra": false
    },
    "calibration": {
        "default_standard": "silicon",
        "default_order": 1,
        "match_tolerance_cm": 15.0
    },
    "microalgae_bands": [
        {"name": "Carotenoid v3", "class": "Carotenoid", "lo": 998, "hi": 1015, "ref": "Sharma2015"},
        {"name": "Carotenoid v2 (C-C)", "class": "Carotenoid", "lo": 1145, "hi": 1170, "ref": "Sharma2015"},
        {"name": "Carotenoid v1 (C=C)", "class": "Carotenoid", "lo": 1505, "hi": 1535, "ref": "Sharma2015"},
        {"name": "Lipid CH2 bend", "class": "Lipid", "lo": 1430, "hi": 1455, "ref": "Wu2011"},
        {"name": "Lipid C=C", "class": "Lipid", "lo": 1645, "hi": 1670, "ref": "Wu2011"},
        {"name": "Lipid =C-H cis", "class": "Lipid", "lo": 1255, "hi": 1275, "ref": "Wu2011"},
        {"name": "Lipid ester C=O", "class": "Lipid", "lo": 1725, "hi": 1750, "ref": "Wu2011"},
        {"name": "Lipid CH2 sym str", "class": "Lipid", "lo": 2835, "hi": 2865, "ref": "Ni2017"},
        {"name": "Lipid CH2 asym str", "class": "Lipid", "lo": 2870, "hi": 2905, "ref": "Wu2011"},
        {"name": "PUFA =C-H str", "class": "PUFA", "lo": 3000, "hi": 3025, "ref": "Sharma2015"},
        {"name": "SatFA C-C (1063)", "class": "Saturated FA", "lo": 1055, "hi": 1073, "ref": "LipidRev"},
        {"name": "SatFA C-C (1128)", "class": "Saturated FA", "lo": 1118, "hi": 1138, "ref": "LipidRev"},
        {"name": "Protein Phe", "class": "Protein", "lo": 998, "hi": 1010, "ref": "Ni2017"},
        {"name": "Protein amide III", "class": "Protein", "lo": 1240, "hi": 1300, "ref": "Sharma2015"},
        {"name": "Protein amide I", "class": "Protein", "lo": 1650, "hi": 1685, "ref": "Sharma2015"},
        {"name": "Starch glycosidic", "class": "Carbohydrate", "lo": 468, "hi": 488, "ref": "Starch478"},
        {"name": "Starch skeletal", "class": "Carbohydrate", "lo": 930, "hi": 950, "ref": "Ni2017"},
        {"name": "Carbohydrate C-O", "class": "Carbohydrate", "lo": 1070, "hi": 1095, "ref": "Wei2016"},
        {"name": "Total biomass CH", "class": "Total", "lo": 2800, "hi": 3025, "ref": "Ni2017"}
    ],
    "microalgae_ratios": [
        {"name": "Unsaturation (I1658/I1441)", "numerator": "Lipid C=C", "denominator": "Lipid CH2 bend", "ref": "Wu2011"},
        {"name": "Saturation index", "numerator": "Lipid CH2 bend", "denominator": "Lipid C=C", "ref": "Wu2011"},
        {"name": "PUFA index", "numerator": "PUFA =C-H str", "denominator": "Lipid CH2 sym str", "ref": "Sharma2015"},
        {"name": "Lipid/Protein", "numerator": "Lipid CH2 sym str", "denominator": "Protein amide III", "ref": "Ni2017"},
        {"name": "Carotenoid/Lipid", "numerator": "Carotenoid v1 (C=C)", "denominator": "Lipid CH2 bend", "ref": "Sharma2015"},
        {"name": "Starch/Lipid", "numerator": "Starch glycosidic", "denominator": "Lipid CH2 bend", "ref": "Wei2016"},
        {"name": "Total-lipid/biomass", "numerator": "Lipid CH2 sym str", "denominator": "Total biomass CH", "ref": "Ni2017"}
    ],
    "microalgae_references": [
        {"key": "Wu2011", "citation": "Wu et al. (2011). In vivo lipidomics using single-cell Raman spectroscopy. PNAS 108(9):3809-3814. Validates I1650/I1440 vs. C=C degree (R2=0.99).", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3048102/"},
        {"key": "Wei2016", "citation": "Rapid in vivo lipid/carbohydrate quantification of single microalgal cell by Raman spectral imaging (salinity-induced starch-to-lipid shift). Biotechnol. Biofuels 9:200 (2016).", "url": "https://biotechnologyforbiofuels.biomedcentral.com/articles/10.1186/s13068-016-0691-y"},
        {"key": "Ni2017", "citation": "Label-free simultaneous quantification of starch, protein and triacylglycerol in single microalgal cells. Biotechnol. Biofuels (2017). Marker set: starch 478/865/940/1049/1127; protein 1003/1586/1610; TAG 972/1265/1441/1658/2851.", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5693592/"},
        {"key": "Sharma2015", "citation": "An integrative Raman microscopy-based workflow for rapid in situ analysis of microalgal lipid bodies. Biotechnol. Biofuels 8:164 (2015). Carotenoid 1006/1155/1520; =C-H 3003-3023; amide bands.", "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4595058/"},
        {"key": "Starch478", "citation": "Raman spectroscopy for rapid, non-invasive quantitation of starch in live unicellular microalgae. 478 cm-1 (a-1,4 glycosidic), R2=0.989 vs. starch content.", "url": "https://pubmed.ncbi.nlm.nih.gov/24906189/"},
        {"key": "LipidRev", "citation": "Czamara et al. (2015). Raman spectroscopy of lipids: a review. J. Raman Spectrosc. 46:4-20. Saturated all-trans acyl C-C markers 1063/1128 cm-1.", "url": "https://doi.org/10.1002/jrs.4607"}
    ],
    "microalgae": {
        "default_method": "height",
        "local_baseline": true
    }
}
